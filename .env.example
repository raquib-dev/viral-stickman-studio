# Copy to .env (gitignored). Never commit real keys. The app never logs, stores or displays them.

# Claude Agent SDK. Optional if you are logged in to Claude Code on this machine.
ANTHROPIC_API_KEY=

# Render backends (only the one you use is required)
GEMINI_API_KEY=
FAL_KEY=

# Discovery (YouTube Data API v3, read-only API key, no OAuth)
YOUTUBE_API_KEY=

# Optional: full path to ffmpeg/ffprobe if they are not on PATH (Windows example: C:\ffmpeg\bin\ffmpeg.exe)
FFMPEG_PATH=
FFPROBE_PATH=
